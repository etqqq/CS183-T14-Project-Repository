/**
 * Use the old  ONNX model to predict work time
 * It is used to contract with DNN model (A/B Testing)
 * @return The time we predict(second)
 */
public double predictLinearTime(double queueLength, double evaType) {
    double predictedTime = 60.0; 
    try {
        // 1. Ready to input data
        float[][] inputData = new float[][]{ 
            { (float)queueLength, (float)evaType } 
        };
        
        // 2. Make the input called "Tensor"
        ai.onnxruntime.OnnxTensor inputTensor = ai.onnxruntime.OnnxTensor.createTensor(ortEnv, inputData);
        
        // 3. Creat the Map
        java.util.Map<String, ai.onnxruntime.OnnxTensor> inputs = new java.util.HashMap<>();
        inputs.put("input", inputTensor); 
        
        // 4. Use the predict
        ai.onnxruntime.OrtSession.Result result = ortOldSession.run(inputs);
        
        // 5. Anylase the output
        float[][] outputData = (float[][]) result.get(0).getValue();
        predictedTime = (double) outputData[0][0];
        
        // 6. Close the source
        inputTensor.close();
        result.close();
        
    } catch (Exception e) {
        traceln("use the formal time" + e.getMessage());
        
        predictedTime = 60.0 - queueLength * 0.5; 
    }
    
    // Ensure the value of the return is positive number
    return Math.max(predictedTime, 5.0); 
}
